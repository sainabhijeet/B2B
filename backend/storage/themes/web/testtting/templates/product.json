    {
      "id": "header",
      "type": "header",
      "settings": {
        "logoText": "RideGo",
        "nav": ["Home", "Catalog", "Cart", "Orders"]
      }
    },
    {
      "id": "product-detail",
      "type": "product-detail",
      "settings": {
        "showSku": true,
        "showTax": true,
        "showMoq": true,
        "primaryCta": "Add to cart"
      }
    },
    {
      "id": "product-trust",
      "type": "trust-badges",
      "settings": {
        "items": ["MOQ checked", "GST calculated", "Distributor fulfilled"]
      }
    },
    {
      "id": "related",
      "type": "related-products",
      "settings": {
        "title": "Related products"
      }
    },
    {
      "id": "footer",
      "type": "footer-columns",
      "settings": {
        "columns": [
          { "heading": "Store", "links": ["Catalog", "Categories"] },
          { "heading": "Support", "links": ["Contact", "Returns", "Invoices"] }
        ]
      }
    }
