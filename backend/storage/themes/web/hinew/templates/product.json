{
  "sections": [
    {
      "id": "header",
      "type": "header",
      "settings": {
        "logoText": "localizationTest.theme.name",
        "nav": ["localizationTest.nav.home", "localizationTest.nav.categories", "localizationTest.nav.cart", "localizationTest.nav.account"]
      }
    },
    {
      "id": "product-detail",
      "type": "product-detail",
      "settings": {
        "title": "localizationTest.productPage.title",
        "description": "localizationTest.productPage.description",
        "price": "localizationTest.productPage.price",
        "primaryCta": "localizationTest.productPage.addToCart",
        "secondaryCta": "localizationTest.productPage.requestQuote"
      }
    },
    {
      "id": "related",
      "type": "product-grid",
      "settings": {
        "title": "localizationTest.productPage.relatedTitle",
        "subtitle": "localizationTest.productPage.relatedDescription"
      }
    },
    {
      "id": "footer",
      "type": "footer",
      "variant": "columns",
      "settings": {
        "columns": [
          {"heading": "localizationTest.footer.shop", "links": ["localizationTest.nav.categories", "localizationTest.nav.products"]},
          {"heading": "localizationTest.footer.support", "links": ["localizationTest.footer.contact", "localizationTest.footer.terms"]}
        ]
      }
    }
  ]
}
