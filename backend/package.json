{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "stop:dev": "bash -c 'P=${PORT:-3000}; lsof -ti :\"$P\" | xargs kill -9 2>/dev/null || true; pkill -f \"nest start\" 2>/dev/null || true; echo \"stop:dev: freed port $P and nest start processes (if any).\"'",
    "start:worker": "ts-node src/workers/main.worker.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/database/migrations/auto",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:verify": "ts-node src/scripts/theme-migration-verify.ts",
    "monitoring:seed": "ts-node src/scripts/monitoring-seed.ts",
    "tenants:seed": "ts-node src/scripts/tenants-seed.ts",
    "tenant-schemas:audit": "ts-node src/scripts/tenant-schema-audit.ts",
    "tenant-schemas:repair": "ts-node src/scripts/provision-existing-tenant-schemas.ts",
    "countries:seed": "ts-node src/scripts/countries-seed.ts",
    "locations:seed": "ts-node src/scripts/locations-master-seed.ts",
    "locations:import-geonames": "ts-node src/scripts/import-geonames-locations.ts",
    "india:download-geonames": "bash scripts/download-geonames-india.sh",
    "india:import-geonames": "ts-node src/scripts/import-india-full-geonames.ts",
    "monitoring:heartbeat": "ts-node src/scripts/monitoring-heartbeat.ts",
    "themes:inventory": "ts-node src/scripts/theme-migration-inventory.ts",
    "themes:backfill": "ts-node src/scripts/theme-migration-backfill.ts",
    "themes:migrate:enterprise": "ts-node src/scripts/theme-enterprise-migrate.ts",
    "themes:localization:audit": "ts-node src/scripts/theme-enterprise-localization-audit.ts",
    "themes:localization:ai": "ts-node src/scripts/theme-enterprise-ai-translate.ts",
    "themes:artifacts:import": "ts-node src/scripts/theme-artifact-import.ts",
    "themes:artifacts:verify": "ts-node src/scripts/theme-artifact-verify.ts",
    "themes:release:intake": "ts-node src/scripts/theme-release-intake.ts",
    "credit:verify-ledger": "ts-node src/scripts/verify-credit-ledger.ts",
    "storefront:test-customer:seed": "ts-node src/scripts/storefront-test-customer-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "adm-zip": "^0.5.17",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "node-vibrant": "^4.0.4",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
