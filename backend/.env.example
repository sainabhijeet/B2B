NODE_ENV=development
# Set to true to return `debug` / `pgCode` / `pgDetail` on HTTP 500 (useful when NODE_ENV=production locally).
HTTP_500_DEBUG=false
PORT=3000
API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=saas_platform
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

JWT_ACCESS_SECRET=replace_with_32_plus_character_access_secret
JWT_REFRESH_SECRET=replace_with_32_plus_character_refresh_secret
JWT_ACCESS_EXPIRES=60m
JWT_REFRESH_EXPIRES=7d
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_ACCESS_MAX_AGE_MS=3600000
AUTH_COOKIE_REFRESH_MAX_AGE_MS=604800000

# Sensitive uploads are never mounted under /storage. Use a persistent volume in production.
PRIVATE_STORAGE_DIR=private-storage
PRIVATE_DOCUMENT_SIGNING_SECRET=replace_with_a_distinct_random_secret_at_least_32_chars
PRIVATE_DOCUMENT_URL_TTL_SECONDS=300

BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace_with_strong_bootstrap_password

# Subdomain URLs: {slug}.APP_PLATFORM_DOMAIN — e.g. platform.app in production, platform.local in dev.
APP_PLATFORM_DOMAIN=platform.local
PASSWORD_RESET_LINK_BASE_URL=http://localhost:3000/reset-password

# Per-tenant Postgres schema: `CREATE SCHEMA` + `_tenant_schema_meta` after tenant insert. Set to false to only persist `schema_name` and provision later via POST /tenants/:id/provision-schema.
TENANT_SCHEMA_AUTO_PROVISION=true

# Fixed development OTP is disabled in all environments.
OTP_FIXED_CODE_ENABLED=false
# Local development only: return the random single-use OTP in the send response.
# Production and staging validation require this to remain false.
OTP_DEVELOPMENT_ECHO_ENABLED=false
OTP_DEVELOPMENT_FIXED_LOGIN_ENABLED=false
OTP_DEVELOPMENT_FIXED_PHONE=
OTP_DEVELOPMENT_FIXED_CODE=
STOREFRONT_TEST_CUSTOMER_CREDIT_LIMIT=50000.00

# Firebase Admin (FCM + customer phone auth verifyIdToken): configure in Super Admin → Integrations → Push (stored in system_config).

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
PAYMENT_THROTTLE_TTL_MS=60000
PAYMENT_THROTTLE_LIMIT=10
# Phase 0 theme migration controls. Keep disabled until the corresponding phase is approved.
THEME_MIGRATION_DIAGNOSTICS_ENABLED=false
THEME_MIGRATION_SHADOW_READS=false
THEME_MIGRATION_DUAL_WRITE=false
THEME_MIGRATION_CANONICAL_RUNTIME=false
THEME_MIGRATION_ROLLOUT_PERCENT=0
# Comma-separated browser origins (Super Admin :5173, Distributor :5174, Storefront :5175).
# Include 127.0.0.1 if you open UIs via http://127.0.0.1:5173 (Origin differs from localhost).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
SWAGGER_ENABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@platform.com
SMTP_FROM_NAME=SaaS Platform
BUILD_AUTO_CREATE_VERSION=false
# Optional: absolute Flutter executable path for APK builds when `flutter` is not on PATH.
# BUILD_FLUTTER_BIN=P:\new\flutter\bin\flutter.bat
# Production builds must use a public HTTPS API URL. LAN inference and insecure HTTP are local testing only.
BUILD_MOBILE_API_BASE_URL=
BUILD_INFER_LAN_API_BASE_URL=false
BUILD_MOBILE_ALLOW_INSECURE_HTTP=false
# Required for signed Android release APK/AAB builds. Keep the keystore and passwords private.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Required for App Store uploads. The command receives IPA_PATH and App Store Connect credentials via environment.
# It may print {"buildId":"<uuid>"} or APP_STORE_BUILD_ID=<uuid>; otherwise the API looks up the uploaded build.
APP_STORE_CONNECT_UPLOAD_COMMAND=
APP_STORE_BUILD_LOOKUP_ATTEMPTS=18
APP_STORE_BUILD_LOOKUP_DELAY_MS=10000
MOBILE_RELEASE_ENCRYPTION_KEY=replace_with_a_distinct_32_plus_character_secret

# Meta WhatsApp Cloud API (optional until webhooks are configured).
# Webhook (pick one in Meta): POST/GET /api/v1/webhooks/whatsapp OR /api/v1/whatsapp/webhook — hub.* query on GET for verification.
# Outbound Graph API token (same for all tenants). Tenant → phone number ID only in Super Admin UI (`platform_whatsapp_numbers`).
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v18.0
# Optional base URL for invoice deep links (no trailing slash): {{invoiceLink}} = base + "/" + encodeURIComponent(invoiceNumber)
# WHATSAPP_INVOICE_LINK_BASE_URL=
# Log full webhook JSON. Keep false in production.
# WHATSAPP_LOG_FULL_PAYLOAD=false
# Debug: echo "You said: …" only — skips tenant/customer/order flow (WHATSAPP_WEBHOOK_ECHO=true)
# Optional: storefront URL line in WhatsApp beta repeat-confirm message
# WHATSAPP_STOREFRONT_URL=https://your-tenant.example.com

# Optional: override where `/storage/...` is served from (theme extract, static files, media). Default: `./storage` (cwd).
# BACKEND_STORAGE_DIR=./storage
#
# Uploaded theme ZIP copies (extract always under BACKEND_STORAGE_DIR): monorepo default is repo `../storage`
# when cwd is `backend/` and `../storage` exists → `saas-platform/storage/themes/{web|mobile}/{slug}/*.zip`.
# THEME_ZIP_ARCHIVE_DIR=

# Phase 2 immutable theme artifact controls. Keep disabled while filesystem is authoritative.
# THEME_ARTIFACT_OBJECT_STORAGE_ENABLED=false
# THEME_ARTIFACT_DUAL_PUBLISH_ENABLED=false
# THEME_ARTIFACT_IMPORT_ENABLED=false
# THEME_ARTIFACT_VERIFICATION_ENABLED=false
# THEME_ARTIFACT_HEALTH_CHECKS_ENABLED=false

# Phase 3 release intake/validation controls. Keep disabled; filesystem runtime is unaffected.
# THEME_RELEASE_PIPELINE_ENABLED=false
# THEME_RELEASE_PREVIEW_ENABLED=false
# THEME_RELEASE_SECURITY_VALIDATION_ENABLED=false
# THEME_RELEASE_QUARANTINE_DIR=
# THEME_RELEASE_MAX_ARCHIVE_BYTES=104857600
# THEME_RELEASE_MAX_UNCOMPRESSED_BYTES=524288000
# THEME_RELEASE_MAX_COMPRESSION_RATIO=100
# THEME_RELEASE_SUPPORTED_ENGINE_MAJOR=2
# THEME_RELEASE_LIFECYCLE_ENABLED=false
# THEME_RELEASE_LIFECYCLE_METRICS_ENABLED=false
# THEME_DEPLOYMENT_ENGINE_ENABLED=false
# THEME_DEPLOYMENT_METRICS_ENABLED=false
# THEME_DEPLOYMENT_LOCK_LEASE_SECONDS=300
# THEME_RUNTIME_SHADOW_ENABLED=false
# THEME_RUNTIME_COMPARISON_STORAGE_ENABLED=false
# THEME_RUNTIME_METRICS_ENABLED=false
# THEME_RUNTIME_HEALTH_ENABLED=false
# THEME_RUNTIME_SHADOW_SAMPLE_RATE=1
# THEME_RUNTIME_SHADOW_MAX_CONCURRENCY=4
# THEME_RUNTIME_SHADOW_QUEUE_CAPACITY=1000

# Optional standalone worker heartbeat metadata
MONITORING_WORKER_HOSTNAME=build-worker-1
MONITORING_HEARTBEAT_INTERVAL_MS=30000
MONITORING_ACTIVE_JOBS=0
# THEME_RUNTIME_SHADOW_TIMEOUT_MS=1500
# THEME_RUNTIME_SHADOW_CIRCUIT_FAILURE_THRESHOLD=5
# THEME_RUNTIME_SHADOW_CIRCUIT_RESET_MS=30000
# THEME_RUNTIME_REPORT_MAX_BYTES=262144
# THEME_RUNTIME_REPORT_RETENTION_DAYS=30
# Language consistency is disabled by default. Enable only after translation QA.
# THEME_LANGUAGE_CONSISTENCY_ENABLED=false
# THEME_LANGUAGE_CACHE_TTL_MS=300000
# THEME_LANGUAGE_PUBLISH_BLOCKING=true

# Razorpay test or live credentials used by SaaS billing and storefront order checkout.
# Use rzp_test_* keys until end-to-end testing is complete. Never expose KEY_SECRET to clients.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
