# Enables the isolated Theme Preview Experience in the distributor panel.
VITE_THEME_PREVIEW_ENABLED=false
VITE_LANGUAGE_CONSISTENCY_ENABLED=false

# Real storefront renderer origin, for example http://localhost:5175.
VITE_STOREFRONT_PREVIEW_URL=http://localhost:5175

# Optional real mobile app preview renderer URL.
# VITE_MOBILE_PREVIEW_URL=http://localhost:5176

# Distributor panel opened by the audited Super Admin tenant handoff.
VITE_DISTRIBUTOR_PANEL_URL=http://localhost:5174
