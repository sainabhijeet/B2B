# Optional. If unset during `npm run dev`, the app calls same-origin `/api/v1/*`
# and Vite proxies `/api` to http://localhost:3000 (see vite.config.ts).
# Uncomment and adjust if Nest runs elsewhere:
# VITE_API_URL=http://127.0.0.1:3000

# Optional. Point Website Builder mobile preview at the real Flutter app
# running as web from tenant-apps/mobile-app.
# VITE_MOBILE_APP_PREVIEW_URL=http://localhost:5180

# Isolated real-renderer live theme editor; disabled by default.
# VITE_THEME_LIVE_EDITOR_ENABLED=true
