{
  "sections": [
    {
      "id": "header",
      "type": "header",
      "settings": {
        "logoText": "localizationTest.theme.name",
        "nav": ["localizationTest.nav.home", "localizationTest.nav.categories", "localizationTest.nav.products", "localizationTest.nav.cart"]
      }
    },
    {
      "id": "category-intro",
      "type": "rich-text",
      "settings": {
        "title": "localizationTest.categoryPage.title",
        "body": "localizationTest.categoryPage.description"
      }
    },
    {
      "id": "category-products",
      "type": "product-grid",
      "settings": {
        "title": "localizationTest.products.title",
        "subtitle": "localizationTest.products.description"
      }
    },
    {
      "id": "footer",
      "type": "footer",
      "variant": "columns",
      "settings": {
        "columns": [
          {"heading": "localizationTest.footer.shop", "links": ["localizationTest.nav.categories", "localizationTest.nav.products"]},
          {"heading": "localizationTest.footer.support", "links": ["localizationTest.footer.privacy", "localizationTest.footer.terms"]}
        ]
      }
    }
  ]
}
